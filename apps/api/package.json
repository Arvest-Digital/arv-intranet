    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@arv/db": "workspace:*",
    "@arv/identity": "workspace:*",
    "@arv/kernel": "workspace:*",
    "@arv/platform": "workspace:*",
    "effect": "3.22.2",
    "hono": "4.13.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@arv/tsconfig": "workspace:*",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
