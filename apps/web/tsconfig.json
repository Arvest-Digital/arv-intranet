{
  "extends": "@arv/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["./worker-configuration.d.ts", "vite/client", "node"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./app/*"] }
  },
  "include": [
    ".react-router/types/**/*",
    "app",
    "workers",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts"
  ]
}
